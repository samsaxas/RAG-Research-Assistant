# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Gemini key from https://aistudio.google.com/apikey — without it /ask returns retrieved chunks only
GEMINI_API_KEY=
# Optional: override the Gemini model (ids change over time: https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-3.8-flash

# "tfidf" (light, no downloads) or "huggingface" (production embeddings, needs torch + ~90 MB model download)
EMBEDDING_BACKEND=tfidf

# Optional: if set, /ask, /upload, /documents require the header  X-API-Key: <this value>
API_KEY=

# Optional
# MAX_UPLOAD_MB=10
# LOG_LEVEL=INFO
